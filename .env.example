APP_NAME=DnD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_RETRY_AFTER=360
REDIS_QUEUE_BLOCK_FOR=5
# DB_QUEUE_RETRY_AFTER=360

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required
# AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

VITE_APP_NAME="${APP_NAME}"

# DnD application
KPI_CHECKLIST_LOCK_DAYS=5
KPI_CACHE_TTL_CATEGORIES_SECONDS=300
KPI_CACHE_TTL_DESCRIPTIONS_SECONDS=300
KPI_CACHE_TTL_POSITIONS_SECONDS=300
KPI_CACHE_TTL_LEADERBOARD_SECONDS=60
KPI_REMINDER_CACHE_STORE=kpi_reminders

OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_STORE=true

API_VERSION=0.0.1
SCRAMBLE_DEV_TOOLS=false
# SCRAMBLE_CACHE_STORE=

# MEKAYA_DOCS_ENABLED=false
# MEKAYA_DOCS_URL=
# MEKAYA_DOCS_LABEL=
# MEKAYA_DOCS_NEW_TAB=true

WA_API_URL=https://waghub.mekayastudio.com/api/v1/messages
WA_API_KEY=
WA_CONNECT_TIMEOUT=5
WA_API_TIMEOUT=15
WA_OTP_EXPIRES_IN=60
# WA_OTP_MESSAGE="Kode OTP {app_name} Anda: {otp}. Berlaku {expires_in}. Jangan bagikan kode ini kepada siapa pun."

# Docker Compose production
# Satu instance: biarkan SESSION_DRIVER, CACHE_STORE, QUEUE_CONNECTION, dan
# FILESYSTEM_DISK seperti skeleton Laravel di atas (database + local). Redis
# dan S3 tidak wajib. Volume Compose `storage_data` menyimpan disk local/public.
# DB_ROOT_PASSWORD=
# Nyalakan Redis: COMPOSE_PROFILES=redis
# SESSION_DRIVER=redis
# SESSION_CONNECTION=session
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# APP_MAINTENANCE_STORE=redis
# FILESYSTEM_DISK=public
# FILESYSTEM_DISK=s3
# 1Panel overlay (compose.1panel.yaml) — unik per aplikasi di server yang sama
# COMPOSE_PROJECT_NAME=dnd-web
# WEB_CONTAINER_NAME=dnd-web
# ONEPANEL_WEB_BIND=127.0.0.1
# ONEPANEL_WEB_PORT=8080
# Replica di satu server (compose.scale.yaml)
# LB_BIND=127.0.0.1
# LB_PORT=8080
# Node compute tambahan (compose.app.yaml) — isi IP/host node data
# DB_HOST=10.0.0.5
# REDIS_HOST=10.0.0.5
# Publish data plane ke IP privat (compose.data-expose.yaml)
# DATA_BIND=10.0.0.5
# DB_PUBLISH_PORT=3306
# REDIS_PUBLISH_PORT=6379
# OCTANE_WORKERS=2
# OCTANE_MAX_REQUESTS=500
# OCTANE_MAX_EXECUTION_TIME=300
# FRANKENPHP_MAX_WAIT_TIME=5s
# QUEUE_TIMEOUT=300
# QUEUE_MAX_TIME=3600
# QUEUE_MEMORY=384

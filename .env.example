APP_NAME=DnD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_SESSION_DB=2
REDIS_QUEUE_RETRY_AFTER=360
REDIS_QUEUE_BLOCK_FOR=5

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
# AWS_REQUEST_CHECKSUM_CALCULATION=when_required
# AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

VITE_APP_NAME="${APP_NAME}"

# DnD application
KPI_CHECKLIST_LOCK_DAYS=5
KPI_CACHE_TTL_CATEGORIES_SECONDS=300
KPI_CACHE_TTL_DESCRIPTIONS_SECONDS=300
KPI_CACHE_TTL_POSITIONS_SECONDS=300
KPI_REMINDER_CACHE_STORE=kpi_reminders

OPENAI_API_KEY=
OPENAI_URL=https://api.openai.com/v1
OPENAI_STORE=true

API_VERSION=0.0.1
SCRAMBLE_DEV_TOOLS=false
# SCRAMBLE_CACHE_STORE=

# MEKAYA_DOCS_ENABLED=false
# MEKAYA_DOCS_URL=
# MEKAYA_DOCS_LABEL=
# MEKAYA_DOCS_NEW_TAB=true

WA_API_URL=https://waghub.mekayastudio.com/api/v1/messages
WA_API_KEY=
WA_CONNECT_TIMEOUT=5
WA_API_TIMEOUT=15
WA_OTP_EXPIRES_IN=60
# WA_OTP_MESSAGE="Kode OTP {app_name} Anda: {otp}. Berlaku {expires_in}. Jangan bagikan kode ini kepada siapa pun."

